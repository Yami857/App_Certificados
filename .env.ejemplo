# Variables de entorno de la app (plantilla).
# Copia este archivo como .env y completa los valores en tu máquina.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Base de datos. Si queda vacío, la app usa SQLite local (academia.db).
DATABASE_URL=

# Clave para firmar la cookie de sesión. Si queda vacía, la app genera una
# aleatoria al arrancar (las sesiones se pierden en cada reinicio).
SECRET_KEY=

# Usuario administrador (rol "admin")
ADMIN_CORREO=
ADMIN_CLAVE=

# Usuario normal (rol "usuario")
USUARIO_CORREO=
USUARIO_CLAVE=
